# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (for menu analysis only - images now use free libraries)
OPENAI_API_KEY=your-openai-api-key

# Image Libraries (Optional - uses curated images if not provided)
PEXELS_API_KEY=your-pexels-api-key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Google OAuth (for social login)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id

# Apple OAuth
EXPO_PUBLIC_APPLE_SERVICE_ID=your-apple-service-id

# RevenueCat (for subscriptions)
EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-api-key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-ios-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your-android-key

# App Config (Updated with better pricing after cost reduction)
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_FREE_TIER_SCANS=10
EXPO_PUBLIC_PRO_TIER_SCANS=100
